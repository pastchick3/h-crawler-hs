cabal-version: 3.16
name: h-crawler-hs
version: 0.1.0.0
license: MIT
license-file: LICENSE
author: pastchick3
maintainer: pastchick3@gmail.com
build-type: Simple
extra-doc-files:
    CHANGELOG.md,
    LICENSE,
    README.md,

common options
    ghc-options: -Wall
    default-language: GHC2024
    default-extensions:
        MultiWayIf,
        BlockArguments,
        LexicalNegation,
        DuplicateRecordFields,
        NoFieldSelectors,
        OverloadedRecordDot,
        OrPatterns,
        MultilineStrings,

library
    import: options
    hs-source-dirs: src
    exposed-modules: Lib
    other-modules:
        Config,
        Fanbox,
    build-depends:
        aeson ^>= 2.3.1.0,
        base ^>= 4.22.0.0,
        bytestring ^>= 0.12.2.0,
        directory ^>= 1.3.11.0,
        filepath ^>= 1.5.5.0,
        http-conduit ^>= 2.3.9.1,
        process ^>= 1.6.30.0,
        regex-tdfa ^>= 1.3.2.5,
        toml-parser ^>= 2.0.2.0,
        transformers ^>= 0.6.3.0,

executable h-crawler-hs
    import: options
    hs-source-dirs: app
    main-is: Main.hs
    build-depends:
        base ^>= 4.22.0.0,
        h-crawler-hs,
        text ^>= 2.1.4,
        toml-parser ^>= 2.0.2.0,
